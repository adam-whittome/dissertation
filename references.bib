	pages = {27--38},
	file = {Full Text PDF:/home/adam/Zotero/storage/3SGKS5WZ/Giouroukis et al. - 2020 - A survey of adaptive sampling and filtering algorithms for the internet of things.pdf:application/pdf},
}

@inproceedings{goldsmith_spanish_2010,
