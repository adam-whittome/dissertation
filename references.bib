	pages = {20:1--20:39},
	file = {Full Text PDF:/home/adam/Zotero/storage/WGQIEP5Z/Minakov et al. - 2016 - A Comparative Study of Recent Wireless Sensor Network Simulators.pdf:application/pdf},
}

